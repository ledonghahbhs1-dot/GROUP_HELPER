# ==========================================
# CẤU HÌNH BOT TELEGRAM GUARD & ANTI-SPAM
# ==========================================

# Token bot lấy từ @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Danh sách Telegram User ID của Admin tối cao (cách nhau bởi dấu phẩy)
OWNER_IDS=123456789

# Cho phép username nhắn tin trực tiếp với bot (người khác nhắn bot sẽ im lặng không phản hồi)
ALLOWED_PRIVATE_USERNAMES=wolfmodyt

# Đường dẫn lưu database SQLite (trên Railway có thể map Volume /app/data)
DATABASE_PATH=data/guard_bot.db

# ==========================================
# CẤU HÌNH TELEGRAM PREMIUM VIP CUSTOM EMOJI
# ==========================================
# Icon logo Telegram và Icon đồng hồ giới hạn thời gian (Đã cấu hình sẵn theo yêu cầu)
EMOJI_TELE_LOGO=5211129162206560202
EMOJI_CLOCK=5382194935057372936

# Các icon VIP khác trong hệ thống:
EMOJI_VIP=5368324170671202286
EMOJI_SHIELD=5368324170671202287
EMOJI_WARN=5202101484547766658
EMOJI_BAN=5368324170671202289
EMOJI_MUTE=5368324170671202290
EMOJI_LINK=5368324170671202291
EMOJI_BOT=5368324170671202292
EMOJI_SPAM=5368324170671202293
EMOJI_SUCCESS=5368324170671202294
EMOJI_ERROR=5368324170671202295
EMOJI_SETTINGS=5368324170671202296
EMOJI_DIAMOND=5368324170671202297

# ==========================================
# CẤU HÌNH QUY ĐỊNH NHÓM MẶC ĐỊNH
# ==========================================
# Số lần cảnh cáo tối đa: 2 lần (Quá 2 lần sẽ bị BAN)
DEFAULT_MAX_WARNS=2
DEFAULT_WARN_ACTION=ban
DEFAULT_MUTE_DURATION=3600
# Thời gian tự động xoá thông báo: 30 giây
AUTO_DELETE_LOGS_SEC=30
