# ==========================================
# CẤU HÌNH BOT TELEGRAM GUARD & ANTI-SPAM
# ==========================================

# Token bot lấy từ @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Danh sách Telegram User ID của Admin tối cao (cách nhau bởi dấu phẩy)
OWNER_IDS=123456789

# Cho phép username nhắn tin trực tiếp với bot (người khác nhắn bot sẽ im lặng không phản hồi)
ALLOWED_PRIVATE_USERNAMES=wolfmodyt

# Đường dẫn lưu database SQLite (trên Railway có thể map Volume /app/data)
DATABASE_PATH=data/guard_bot.db

# Video hướng dẫn sẽ được FORWARD từ kênh này khi user hỏi
ARENA_VIDEO_CHAT=@youtubewolfmod
ARENA_VIDEO_MESSAGE_ID=280
# Farm Orb / Quest / Nâng Rank guide (t.me/youtubewolfmod/281)
ORBQUEST_VIDEO_MESSAGE_ID=281
# Max Health / Max Damage / Max Star / Max Level guide (t.me/youtubewolfmod/283)
MAXSTATS_VIDEO_MESSAGE_ID=283
# Force Recall / No-Duplicate Recall guide (t.me/youtubewolfmod/284)
RECALL_VIDEO_MESSAGE_ID=284
# Move Habitat & Building guide (t.me/youtubewolfmod/285)
HABITAT_VIDEO_MESSAGE_ID=285
# Skip Heroic Race Battle Time guide (t.me/youtubewolfmod/290)
HEROICRACE_VIDEO_MESSAGE_ID=290
# Bypass Verified Skill guide (t.me/youtubewolfmod/295)
BYPASSVERIFY_VIDEO_MESSAGE_ID=295
# Trading Without Sample guide (t.me/youtubewolfmod/298)
NOTRADE_VIDEO_MESSAGE_ID=298
# How to get Free Key guide (t.me/youtubewolfmod/315)
FREEKEY_VIDEO_MESSAGE_ID=315

# WolfMod.xyz VIP Key checkout API base URL (used by the in-bot "Buy VIP Key" button)
WOLFMOD_API_BASE_URL=https://www.wolfmod.xyz
# Must match the ENCRYPTION_KEY constant in that backend's api/index.ts exactly
# (required only for the VietQR/SePay bank-transfer payment option - do NOT
# commit the real value here, set it directly in Railway/.env)
WOLFMOD_ENC_KEY=

